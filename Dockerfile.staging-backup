FROM postgres:18-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       python3 python3-cryptography \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY deploy/staging_backup.py /app/staging_backup.py

ENTRYPOINT []

USER postgres

CMD ["python3", "/app/staging_backup.py"]
