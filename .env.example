# PrepBuddy environment configuration template
# Never place actual credentials in this file.

# Django
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# PostgreSQL
DATABASE_URL=

# Redis and Celery
REDIS_URL=redis://127.0.0.1:6379/0

# HTTPS security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# ANN configuration
CHATBOT_BACKEND=ann
ANN_RECORD_EXPERIENCES=False

# Staging access control
STAGING_MODE=False
STAGING_ACCESS_TOKEN=

# Email configuration
EMAIL_SEND_ENABLED=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# OpenWA configuration
OPENWA_BASE_URL=http://127.0.0.1:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_PROXY_TOKEN=
OPENWA_RELAY_URL=
OPENWA_WEBHOOK_SECRET=
WHATSAPP_SEND_ENABLED=False

# Legacy WhatsApp provider
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
